# Copy to .env.local and fill from your Firebase project's web app config
# (Firebase console > Project settings > Your apps > Web app).
# These are public client identifiers, not secrets. Never commit .env.local,
# service-account keys, or App Check debug tokens.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key for App Check in production.
VITE_RECAPTCHA_SITE_KEY=
